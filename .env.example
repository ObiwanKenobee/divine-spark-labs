# Payment hosted links per plan (hosted checkout redirects)
# Example keys (replace with your test links)
VITE_PAYMENT_LINK_SANCTUM=https://example.com/pay/sanctum
VITE_PAYMENT_LINK_INNOVATOR=https://example.com/pay/innovator
VITE_PAYMENT_LINK_INSTITUTIONAL=https://example.com/pay/institutional
VITE_PAYMENT_LINK_CIVILIZATION=https://example.com/pay/civilization

# Provider-specific hosted links (optional overrides)
VITE_MPESA_LINK_INNOVATOR=https://mpesa.test/checkout/abcd
VITE_PAYSTACK_LINK_INNOVATOR=https://paystack.test/checkout/efgh
VITE_PAYPAL_LINK_INNOVATOR=https://paypal.test/checkout/ijkl
VITE_CRYPTO_LINK_INNOVATOR=https://commerce.test/checkout/mnop

# Webhook secrets (place test provider webhook secrets here) - used by supabase/functions/payment-webhook
MPESA_WEBHOOK_SECRET=replace_with_mpesa_webhook_secret
PAYSTACK_WEBHOOK_SECRET=replace_with_paystack_webhook_secret
PAYPAL_WEBHOOK_SECRET=replace_with_paypal_webhook_secret
CRYPTO_WEBHOOK_SECRET=replace_with_crypto_webhook_secret
PAYMENT_WEBHOOK_SECRET=replace_with_generic_payment_webhook_secret

# SendGrid (for newsletter emails) - placeholder for prototype
SENDGRID_API_KEY=replace_with_sendgrid_api_key

# Supabase functions base URL (optional) - leave empty to use relative paths or set to your functions host
VITE_SUPABASE_FUNCTIONS_URL=

# Note: For prototype/testing, copy .env.example to .env and replace placeholders with test credentials/links.
# Keep secrets out of source control in production. This example is for local/dev prototyping only.
